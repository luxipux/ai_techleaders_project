# Copy to `.env.local` (repo root) and adjust. Loaded by Next.js and the MikroORM CLI via @next/env.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/devmentor

# Connection pool size per Node.js process (optional)
DB_POOL_MIN=0
DB_POOL_MAX=10

# Log SQL queries (optional, "true" to enable)
DB_DEBUG=false
