{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app --",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migrate": "npm run migrate -w @devmentor/db --",
    "db:migrate:down": "npm run migrate:down -w @devmentor/db --",
    "db:migration:list": "npm run migration:list -w @devmentor/db --",
    "db:schema:check": "npm run migration:check -w @devmentor/db --"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
